{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://blackwoodblake.com/design-system/schema/justified.schema.json",
  "title": "Justified project overrides",
  "description": "Your project's own decisions to depart from rules and guidelines of Justified by Blackwood & Blake. Each needs a reason.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "overrides"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "justified": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+",
      "description": "The Justified version the file was written for. Informational."
    },
    "overrides": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "action",
          "reason"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z]{3}-\\d{3}[a-z]?$",
            "enum": [
              "ACT-001a",
              "ACT-001b",
              "ACT-002a",
              "ACT-002b",
              "ACT-003a",
              "ACT-003b",
              "ACT-004",
              "ACT-005",
              "ACT-006",
              "ACT-007a",
              "ACT-007b",
              "ACT-008",
              "ACT-009",
              "ACT-009a",
              "ACT-009b",
              "DLG-001",
              "DLG-002",
              "DLG-003",
              "DLG-004",
              "DLG-005",
              "DLG-006",
              "DLG-007",
              "DST-001a",
              "DST-001b",
              "FBK-002",
              "FBK-003",
              "FBK-004",
              "FBK-005",
              "FRM-001",
              "FRM-002a",
              "FRM-002b",
              "FRM-003",
              "FRM-004a",
              "FRM-004b",
              "FRM-004c",
              "FRM-004d",
              "FRM-005",
              "FRM-007",
              "FRM-008",
              "FRM-009",
              "FRM-010",
              "FRM-011",
              "FRM-012a",
              "FRM-012b",
              "FRM-013",
              "FRM-014",
              "FRM-014a",
              "FRM-014b",
              "FRM-015",
              "FRM-016a",
              "FRM-016b",
              "FRM-017",
              "FRM-017a",
              "FRM-017b",
              "FRM-017c",
              "KBD-001",
              "KBD-002",
              "KBD-003",
              "KBD-003a",
              "KBD-003b",
              "LAY-001",
              "LAY-002",
              "LAY-003a",
              "LAY-003b",
              "NAV-002a",
              "NAV-002b",
              "NAV-003",
              "NAV-004",
              "STA-001",
              "STA-002a",
              "STA-002b",
              "STA-003",
              "STA-004",
              "STA-005a",
              "STA-005b",
              "STR-001",
              "STR-002a",
              "STR-002b",
              "STR-003",
              "STR-004",
              "STR-005",
              "STR-006",
              "STR-006a",
              "TBL-001",
              "TBL-002",
              "TBL-003",
              "TBL-004",
              "TXT-001a",
              "TXT-002a",
              "TXT-002b",
              "TXT-003",
              "VIS-001",
              "VIS-002",
              "VIS-003a",
              "VIS-003b",
              "VIS-004",
              "VIS-005",
              "VIS-006",
              "VIS-007",
              "VIS-008",
              "VIS-008a",
              "VIS-008b"
            ],
            "description": "One exact id. No wildcards or families."
          },
          "action": {
            "enum": [
              "off",
              "guideline",
              "note"
            ],
            "description": "off: the project does not follow the text. guideline: treat a rule as a guideline that yields to the project's own convention (not for a WCAG requirement). note: the text applies in full; the reason is context."
          },
          "reason": {
            "type": "string",
            "minLength": 20,
            "description": "Your project's own words for the decision."
          },
          "files": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[^!]",
              "minLength": 1
            },
            "description": "Positive globs, relative to this file. Without it, the whole project."
          },
          "rule_version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$",
            "description": "The version of the rule the override was written against."
          },
          "review_by": {
            "type": "string",
            "format": "date",
            "description": "A date to look at the decision again. ESLint ignores it."
          },
          "owner": {
            "type": "string"
          },
          "lint_rules": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^justified/"
            },
            "description": "Limits off and guideline to some of the id's lint rules."
          }
        }
      }
    }
  }
}
